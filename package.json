{
  "name": "dttd",
  "version": "1.54.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "preview": "dotenv -e .env.preview -v SITE_URL=http://localhost:3000 -- next dev --turbopack",
    "preview:pull": "vercel env pull .env.preview --environment=preview --yes",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "build": "next build",
    "start": "next start",
    "lint": "npx eslint . --ext .ts,.tsx",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "db:start": "supabase start",
    "db:stop": "supabase stop --project-id dttd",
    "db:status": "supabase status",
    "db:migrate": "supabase migration new",
    "db:reset": "supabase db reset && bun run seed --yes",
    "seed": "node scripts/seed/index.ts",
    "db:generate": "supabase gen types typescript --local > database.types.ts",
    "test": "jest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.6",
    "@sentry/nextjs": "^11",
    "@stripe/stripe-js": "^9.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "pino": "^10.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.0.2",
    "react-hook-form": "^7.60.0",
    "react-is": "^19",
    "react-select": "^5.10.2",
    "recharts": "3.10.1",
    "resend": "^6.29.0",
    "sonner": "^2.0.6",
    "stripe": "^18.2.0",
    "supabase": "^2.116.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "5.103.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.49.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.2.7",
    "semantic-release": "^25.0.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tw-animate-css": "^1.3.5",
    "typescript": "^6",
    "typescript-eslint": "^8.49.0"
  },
  "main": "index.js",
  "repository": "https://github.com/sdavisde/dttd.git",
  "author": "sdavisde <sdavisde@gmail.com>",
  "license": "MIT"
}
