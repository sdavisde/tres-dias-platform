# Supabase Configuration
# Get these values from your Supabase project dashboard or local development setup

# Public Supabase URL - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Public Supabase Publishable Key - safe to expose to the browser
# For local development: use the publishable key from `yarn db:status`
# For production: use the publishable key (sb_publishable_...) from Supabase dashboard
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY={{NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY}}

# Supabase Secret Key - NEVER expose to the browser, server-side only
# For local development: use the Secret key from `yarn db:status`
# For production: use the secret key (sb_secret_...) from Supabase dashboard
SUPABASE_SECRET_KEY={{SUPABASE_SECRET_KEY}}

# Stripe / Payment Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY={{NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY}}
STRIPE_SECRET_KEY={{STRIPE_SECRET_KEY}}
# The webhook secret provided by Stripe to authenticate requests to the CLI
STRIPE_WEBHOOK_SECRET={{STRIPE_WEBHOOK_SECRET}}
# The Stripe products fees are sold under (prod_...). They need no price: the amount comes from
# each weekend group's fees. The product only keeps Stripe reports grouped by fee type.
CANDIDATE_FEE_PRODUCT_ID={{CANDIDATE_FEE_PRODUCT_ID}}
TEAM_FEE_PRODUCT_ID={{TEAM_FEE_PRODUCT_ID}}

# Resend (Email sending) keys
RESEND_API_KEY={{RESEND_API_KEY}}

# O11Y Keys
SENTRY_AUTH_TOKEN={{SENTRY_AUTH_TOKEN}}
# Set to "false" to keep a production build from reporting to Sentry (CI does this). Unset on Vercel.
NEXT_PUBLIC_SENTRY_ENABLED=

# General keys
SITE_URL=http://localhost:3000

# E2E (Playwright) — optional overrides
# Base URL the E2E suite drives (default http://localhost:3000)
E2E_BASE_URL=
# Shared password of every seeded account (default "password")
E2E_SEED_PASSWORD=
